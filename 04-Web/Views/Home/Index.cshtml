<h2>Welcome to the TRSB Translation Portal</h2>

@if (!User.Identity.IsAuthenticated)
{
    <p>
        <a class="btn btn-primary" asp-controller="User" asp-action="Login">Login</a>
        <a class="btn btn-secondary" asp-controller="User" asp-action="Register">Register</a>
    </p>
}
else
{
    <p>
        <a class="btn btn-success" asp-controller="TranslationPage" asp-action="MyRequests">
            Go to My Translation Requests
        </a>
    </p>
}