@{
    ViewData["Title"] = "Forbidden";
}

<div class="text-center mt-5">
    <h2 class="text-danger mb-4"><strong>403 - Forbidden</strong> </h2>
    <p class="mb-4">You don't have permission to access this resource.</p>

    <img src="~/images/youdidntsaythemagicword.gif"
         alt="You didn't say the magic word"
         class="img-fluid rounded shadow" />

    <p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">
            <i class="bi bi-house-fill"></i> Return Home
        </a>
    </p>
</div>
