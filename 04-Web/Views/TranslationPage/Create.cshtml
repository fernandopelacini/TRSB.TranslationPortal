@model Application.Commands.CreateTranslationRequest.CreateTranslationRequestCommand

<h2>Submit Translation Request</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Source Text</label>
        <textarea asp-for="SourceText" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Source Language</label>
        <input asp-for="SourceLanguage" class="form-control" />
    </div>

    <div class="form-group">
        <label>Target Language</label>
        <input asp-for="TargetLanguage" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Submit</button>
</form>