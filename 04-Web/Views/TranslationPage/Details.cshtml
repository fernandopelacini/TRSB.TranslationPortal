@using Domain.Enums
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Application.DTOs.TranslationRequestDto

<h2>Translation Details</h2>

<p><strong>ID:</strong> @Model.Id</p>
<p><strong>Status:</strong> @Model.Status</p>

<p><strong>Original Text:</strong></p>
<p>@Model.SourceText</p>

@if (Model.Status == TranslationStatus.Completee)
{
    <p><strong>Translated Text:</strong></p>
    <p>@Model.TranslatedText</p>
}
else
{
    <p><em>Translation not completed yet.</em></p>
}
