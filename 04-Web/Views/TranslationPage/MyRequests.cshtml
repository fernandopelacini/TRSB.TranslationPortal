    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<Application.DTOs.TranslationRequestDto>

<h2>My Translation Requests</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Source</th>
            <th>Target</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.SourceLanguage</td>
                <td>@r.TargetLanguage</td>
                <td>@r.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@r.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Submit New Request</a>