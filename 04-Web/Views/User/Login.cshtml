@model Application.Commands.LoginUserRequest.LoginUserCommand

<h2>Login</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Identifier" class="form-label">Username or Email</label>
        <input asp-for="Identifier" class="form-control" />
        <span asp-validation-for="Identifier" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Login</button>

    <p class="mt-3">
        <a asp-controller="User" asp-action="Register">Don't have an account? Register here</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}