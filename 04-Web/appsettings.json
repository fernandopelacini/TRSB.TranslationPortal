{
  "ConnectionStrings": {
    "Default": "<ConnectionString>"
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "MinSpecialChars": 2,
    "SpecialChars": "@#!%&"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
