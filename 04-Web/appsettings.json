{
  "ConnectionStrings": {
    "Default": "<ConnectionString>"
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "MinSpecialChars": 2,
    "SpecialChars": "@#!%&"
  },
  "Jwt": {
    "Key": "<JWT KEY>",
    "Issuer": "<JWT ISSUER>",
    "Audience": "<JWT AUDIENCE>",
    "ExpiresMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
